<p class="form-note">Submitting a request does not create a contract or guarantee a price. Project details and pricing will be confirmed separately.</p>
</div>
</div>
</form>
</div>
</div>
</section>
</main>

<main id="adminPage">
<div class="container admin-shell">
<div class="admin-top">
<div>
<div class="eyebrow">Private area</div>
<h2>BR1Websides <span class="gradient">Admin</span></h2>
<p class="order-meta">Manage incoming website requests.</p>
</div>
<a class="btn btn-outline small-btn" href="#home" id="backToSite">Back to website</a>
</div>

<section id="loginPanel" class="admin-panel">
<h3>Administrator login</h3>
<form id="loginForm" class="admin-form">
<div class="field">
<label for="adminEmail">Email</label>
<input id="adminEmail" type="email" required autocomplete="username" placeholder="Admin email">
</div>
<div class="field">
<label for="adminPassword">Password</label>
<input id="adminPassword" type="password" required autocomplete="current-password" placeholder="Password">
</div>
<button class="btn" id="loginButton" type="submit">Log in</button>
<div id="loginMessage" class="message" role="status"></div>
</form>
</section>

<section id="dashboardPanel" class="admin-panel hidden">
<div class="admin-top">
<div>
<h3>Orders</h3>
<p class="order-meta" id="orderCount">Loading orders...</p>
</div>
<button class="btn btn-outline small-btn" id="logoutButton" type="button">Log out</button>
</div>
<div id="ordersList" class="order-list"><p class="empty">Loading...</p></div>
<div id="dashboardMessage" class="message" role="status"></div>
</section>
</div>
</main>

<footer>
<div class="container footer-content">
<div>
<a class="logo" href="#home">BR1<span>Websides</span></a>
<p>Creative websites. Built around your ideas.</p>
</div>
<div>
<p>© <span id="year"></span> BR1Websides. All rights reserved.</p>
<a class="admin-link" href="#admin">Administrator</a>
</div>
</div>
</footer>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js";
import {
  getFirestore, collection, addDoc, serverTimestamp,
  getDocs, query, orderBy, doc, updateDoc, deleteDoc
} from "https://www.gstatic.com/firebasejs/11.10.0/firebase-firestore.js";
import {
  getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut
} from "https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js";

const firebaseConfig = {
  apiKey: "AIzaSyAfYfFfxg_Rbq2fK1cGSSWwWyx6neN7d4CE",
  authDomain: "br1websides.firebaseapp.com",
  projectId: "br1websides",
  storageBucket: "br1websides.firebasestorage.app",
  messagingSenderId: "925436970134",
  appId: "1:925436970134:web:2a077abb6491d42c442eb7",
  measurementId: "G-FH0FY21NJM"
};

const ADMIN_UID = "7jIl2QtduLVM1WsWhJ7uHgfQCCi1";

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const auth = getAuth(app);
const $ = id => document.getElementById(id);

$("year").textContent = new Date().getFullYear();

$("menuBtn").addEventListener("click", () => {
  $("navLinks").classList.toggle("open");
  $("menuBtn").textContent =
    $("navLinks").classList.contains("open") ? "✕" : "☰";
});

document.querySelectorAll(".navlinks a").forEach(link => {
  link.addEventListener("click", () => {
    $("navLinks").classList.remove("open");
    $("menuBtn").textContent = "☰";
  });
});

function showPage() {
  const admin = location.hash === "#admin";
  $("publicPage").classList.toggle("hidden", admin);
  $("adminPage").classList.toggle("active", admin);
  window.scrollTo(0, 0);

  if (admin && auth.currentUser) loadOrders();
}

window.addEventListener("hashchange", showPage);
showPage();

/* CUSTOMER ORDER FORM */
$("orderForm").addEventListener("submit", async event => {
  event.preventDefault();

  const form = event.currentTarget;
  if (!form.reportValidity()) return;

  const button = $("submitOrder");
  const message = $("formMessage");

  button.disabled = true;
  message.className = "";
  message.textContent = "Sending your request securely...";

  const values = new FormData(form);

  try {
    await addDoc(collection(db, "orders"), {
      name: String(values.get("name")).trim(),
      email: String(values.get("email")).trim(),
      websiteType: String(values.get("type")),
      budget: String(values.get("budget") || "Not specified"),
      description: String(values.get("details")).trim(),
      deadline: String(values.get("deadline") || "Not specified"),
      createdAt: serverTimestamp(),
      status: "Pending",
      consent: $("consent").checked
    });

    form.reset();
    message.className = "success";
    message.textContent = "Thank you! Your request has been sent successfully.";

  } catch (error) {
    console.error("Order submission failed:", error);
    message.className = "error";
    message.textContent = "We couldn't send your request. Please try again later.";

  } finally {
    button.disabled = false;
  }
});

/* ADMIN LOGIN */
$("loginForm").addEventListener("submit", async event => {
  event.preventDefault();

  const button = $("loginButton");
  const message = $("loginMessage");

  button.disabled = true;
  message.className = "message";
  message.textContent = "Signing in...";

  try {
    const credential = await signInWithEmailAndPassword(
      auth,
      $("adminEmail").value.trim(),
      $("adminPassword").value
    );

    if (credential.user.uid !== ADMIN_UID) {
      await signOut(auth);
      throw new Error("This account is not authorized as the BR1Websides administrator.");
    }

    $("adminPassword").value = "";
    message.textContent = "";
    await loadOrders();

  } catch (error) {
    console.error("Admin login failed:", error);
    message.className = "message error";

    message.textContent = error.code === "auth/invalid-credential"
      ? "Incorrect email or password."
      : (error.message || "Login failed. Check your connection and try again.");

  } finally {
    button.disabled = false;
  }
});

/* CHECK AUTHENTICATION */
onAuthStateChanged(auth, async user => {
  if (user && user.uid === ADMIN_UID) {
    $("loginPanel").classList.add("hidden");
    $("dashboardPanel").classList.remove("hidden");

    if (location.hash === "#admin") {
      await loadOrders();
    }

  } else {
    $("loginPanel").classList.remove("hidden");
    $("dashboardPanel").classList.add("hidden");
  }
});

/* LOG OUT */
$("logoutButton").addEventListener("click", async () => {
  await signOut(auth);
  $("loginMessage").textContent = "You have been logged out.";
});

/* LOAD CUSTOMER ORDERS */
async function loadOrders() {
  if (!auth.currentUser || auth.currentUser.uid !== ADMIN_UID) return;

  $("ordersList").innerHTML = '<p class="empty">Loading orders...</p>';
  $("orderCount").textContent = "Loading...";
  $("dashboardMessage").textContent = "";

  try {
    const ordersQuery = query(
      collection(db, "orders"),
      orderBy("createdAt", "desc")
    );

    const snapshot = await getDocs(ordersQuery);

    $("orderCount").textContent = `${snapshot.size} order(s)`;
    $("ordersList").replaceChildren();

    if (snapshot.empty) {
      $("ordersList").innerHTML =
        '<p class="empty">No orders yet. New requests will appear here.</p>';
      return;
    }

    snapshot.forEach(orderDoc => {
      const order = orderDoc.data();

      const card = document.createElement("article");
      card.className = "order-item";

      const title = document.createElement("div");
      title.className = "order-head";

      const heading = document.createElement("strong");
      heading.textContent = order.name || "Unnamed client";

      const statusText = document.createElement("span");
      statusText.className = "order-meta";
      statusText.textContent = order.status || "Pending";

      title.append(heading, statusText);

      const meta = document.createElement("div");
      meta.className = "order-meta";

      const date = order.createdAt?.toDate
        ? order.createdAt.toDate().toLocaleString()
        : "Date unavailable";

      meta.textContent =
        `${order.email || ""} • ${order.websiteType || ""} • ${order.budget || "No budget"} • ${date}`;

      const description = document.createElement("p");
      description.className = "order-description";
      description.textContent = order.description || "";

      const deadline = document.createElement("p");
      deadline.className = "order-meta";
      deadline.textContent =
        `Preferred deadline: ${order.deadline || "Not specified"}`;

      const actions = document.createElement("div");
      actions.className = "order-actions";

      /* CHANGE ORDER STATUS */
      const status = document.createElement("select");

      ["Pending", "In Progress", "Completed"].forEach(value => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        status.append(option);
      });

      status.value = order.status || "Pending";
      status.setAttribute(
        "aria-label",
        `Status for ${order.name || "order"}`
      );

      status.addEventListener("change", async () => {
        status.disabled = true;

        try {
          await updateDoc(doc(db, "orders", orderDoc.id), {
            status: status.value
          });

          statusText.textContent = status.value;
          $("dashboardMessage").className = "message success";
          $("dashboardMessage").textContent = "Order status updated.";

        } catch (error) {
          console.error(error);
          $("dashboardMessage").className = "message error";
          $("dashboardMessage").textContent =
            "Could not update status. Check Firestore rules.";

          status.value = order.status || "Pending";

        } finally {
          status.disabled = false;
        }
      });

      /* DELETE ORDER */
      const remove = document.createElement("button");
      remove.className = "btn btn-outline small-btn";
      remove.type = "button";
      remove.textContent = "Delete";

      remove.addEventListener("click", async () => {
        if (!confirm(
          `Delete the order from ${order.name || "this client"}? This cannot be undone.`
        )) return;

        remove.disabled = true;

        try {
          await deleteDoc(doc(db, "orders", orderDoc.id));

          card.remove();

          const remaining =
            $("ordersList").querySelectorAll(".order-item").length;

          $("orderCount").textContent = `${remaining} order(s)`;

          $("dashboardMessage").className = "message success";
          $("dashboardMessage").textContent = "Order deleted.";

          if (remaining === 0) {
            $("ordersList").innerHTML =
              '<p class="empty">No orders yet.</p>';
          }

        } catch (error) {
          console.error(error);
          $("dashboardMessage").className = "message error";
          $("dashboardMessage").textContent =
            "Could not delete order. Check Firestore rules.";

          remove.disabled = false;
        }
      });

      actions.append(status, remove);
      card.append(title, meta, description, deadline, actions);
      $("ordersList").append(card);
    });

  } catch (error) {
    console.error("Loading orders failed:", error);

    $("ordersList").innerHTML =
      '<p class="empty">Could not load orders. Check that you are signed in as the administrator and that Firestore rules are published.</p>';

    $("orderCount").textContent = "Error";
  }
}
</script>

</body>
</html>
